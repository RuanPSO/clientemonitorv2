  dashboard_page   dashboard_page @relation(fields: [dashboard_pageid], references: [dashboard_pageid], onDelete: Cascade, onUpdate: NoAction, map: "c_widget_1")
  widget_field     widget_field[]

  @@index([dashboard_pageid], map: "widget_1")
}

model widget_field {
  widget_fieldid    BigInt      @id
  widgetid          BigInt
  type              Int         @default(0)
  name              String      @default("") @db.VarChar(255)
  value_int         Int         @default(0)
  value_str         String      @default("") @db.VarChar(2048)
  value_groupid     BigInt?
  value_hostid      BigInt?
  value_itemid      BigInt?
  value_graphid     BigInt?
  value_sysmapid    BigInt?
  value_serviceid   BigInt?
  value_slaid       BigInt?
  value_userid      BigInt?
  value_actionid    BigInt?
  value_mediatypeid BigInt?
  widget            widget      @relation(fields: [widgetid], references: [widgetid], onDelete: Cascade, onUpdate: NoAction, map: "c_widget_field_1")
  actions           actions?    @relation(fields: [value_actionid], references: [actionid], onDelete: Cascade, onUpdate: NoAction, map: "c_widget_field_10")
  media_type        media_type? @relation(fields: [value_mediatypeid], references: [mediatypeid], onDelete: Cascade, onUpdate: NoAction, map: "c_widget_field_11")
  hstgrp            hstgrp?     @relation(fields: [value_groupid], references: [groupid], onDelete: Cascade, onUpdate: NoAction, map: "c_widget_field_2")
  hosts             hosts?      @relation(fields: [value_hostid], references: [hostid], onDelete: Cascade, onUpdate: NoAction, map: "c_widget_field_3")
  items             items?      @relation(fields: [value_itemid], references: [itemid], onDelete: Cascade, onUpdate: NoAction, map: "c_widget_field_4")
  graphs            graphs?     @relation(fields: [value_graphid], references: [graphid], onDelete: Cascade, onUpdate: NoAction, map: "c_widget_field_5")
  sysmaps           sysmaps?    @relation(fields: [value_sysmapid], references: [sysmapid], onDelete: Cascade, onUpdate: NoAction, map: "c_widget_field_6")
  services          services?   @relation(fields: [value_serviceid], references: [serviceid], onDelete: Cascade, onUpdate: NoAction, map: "c_widget_field_7")
  sla               sla?        @relation(fields: [value_slaid], references: [slaid], onDelete: Cascade, onUpdate: NoAction, map: "c_widget_field_8")
  users             users?      @relation(fields: [value_userid], references: [userid], onDelete: Cascade, onUpdate: NoAction, map: "c_widget_field_9")

  @@index([widgetid], map: "widget_field_1")
  @@index([value_actionid], map: "widget_field_10")
  @@index([value_mediatypeid], map: "widget_field_11")
  @@index([value_groupid], map: "widget_field_2")
  @@index([value_hostid], map: "widget_field_3")
  @@index([value_itemid], map: "widget_field_4")
  @@index([value_graphid], map: "widget_field_5")
  @@index([value_sysmapid], map: "widget_field_6")
  @@index([value_serviceid], map: "widget_field_7")
  @@index([value_slaid], map: "widget_field_8")
  @@index([value_userid], map: "widget_field_9")
}
