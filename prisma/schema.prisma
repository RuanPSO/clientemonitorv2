generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model acknowledges {
  acknowledgeid  BigInt   @id
  userid         BigInt
  eventid        BigInt
  clock          Int      @default(0)
  message        String   @default("") @db.VarChar(2048)
  action         Int      @default(0)
  old_severity   Int      @default(0)
  new_severity   Int      @default(0)
  suppress_until Int      @default(0)
  taskid         BigInt?
  users          users    @relation(fields: [userid], references: [userid], onDelete: Cascade, onUpdate: NoAction, map: "c_acknowledges_1")
  events         events   @relation(fields: [eventid], references: [eventid], onDelete: Cascade, onUpdate: NoAction, map: "c_acknowledges_2")
  alerts         alerts[]

  @@index([userid], map: "acknowledges_1")
  @@index([eventid], map: "acknowledges_2")
  @@index([clock], map: "acknowledges_3")
}

model actions {
  actionid           BigInt         @id
  name               String         @unique(map: "actions_2") @default("") @db.VarChar(255)
  eventsource        Int            @default(0)
  evaltype           Int            @default(0)
  status             Int            @default(0)
  esc_period         String         @default("1h") @db.VarChar(255)
  formula            String         @default("") @db.VarChar(1024)
  pause_suppressed   Int            @default(1)
  notify_if_canceled Int            @default(1)
  pause_symptoms     Int            @default(1)
  alerts             alerts[]
  conditions         conditions[]
  operations         operations[]
  widget_field       widget_field[]

  @@index([eventsource, status], map: "actions_1")
}

model alerts {
  alertid                         BigInt        @id
  actionid                        BigInt
  eventid                         BigInt
  userid                          BigInt?
  clock                           Int           @default(0)
  mediatypeid                     BigInt?
  sendto                          String        @default("") @db.VarChar(1024)
  subject                         String        @default("") @db.VarChar(255)
  message                         String        @default("")
  status                          Int           @default(0)
  retries                         Int           @default(0)
  error                           String        @default("") @db.VarChar(2048)
  esc_step                        Int           @default(0)
  alerttype                       Int           @default(0)
  p_eventid                       BigInt?
  acknowledgeid                   BigInt?
  parameters                      String        @default("{}")
  actions                         actions       @relation(fields: [actionid], references: [actionid], onDelete: Cascade, onUpdate: NoAction, map: "c_alerts_1")
  events_alerts_eventidToevents   events        @relation("alerts_eventidToevents", fields: [eventid], references: [eventid], onDelete: Cascade, onUpdate: NoAction, map: "c_alerts_2")
  users                           users?        @relation(fields: [userid], references: [userid], onDelete: Cascade, onUpdate: NoAction, map: "c_alerts_3")
  media_type                      media_type?   @relation(fields: [mediatypeid], references: [mediatypeid], onDelete: Cascade, onUpdate: NoAction, map: "c_alerts_4")
  events_alerts_p_eventidToevents events?       @relation("alerts_p_eventidToevents", fields: [p_eventid], references: [eventid], onDelete: Cascade, onUpdate: NoAction, map: "c_alerts_5")
  acknowledges                    acknowledges? @relation(fields: [acknowledgeid], references: [acknowledgeid], onDelete: Cascade, onUpdate: NoAction, map: "c_alerts_6")

  @@index([actionid], map: "alerts_1")
  @@index([clock], map: "alerts_2")
  @@index([eventid], map: "alerts_3")
  @@index([status], map: "alerts_4")
  @@index([mediatypeid], map: "alerts_5")
  @@index([userid], map: "alerts_6")
  @@index([p_eventid], map: "alerts_7")
  @@index([acknowledgeid], map: "alerts_8")
}

model auditlog {
  auditid       String  @id @db.VarChar(25)
  userid        BigInt?
  username      String  @default("") @db.VarChar(100)
  clock         Int     @default(0)
  ip            String  @default("") @db.VarChar(39)
  action        Int     @default(0)
  resourcetype  Int     @default(0)
  resourceid    BigInt?
  resource_cuid String? @db.VarChar(25)
  resourcename  String  @default("") @db.VarChar(255)
  recordsetid   String  @db.VarChar(25)
  details       String  @default("")

  @@index([userid, clock], map: "auditlog_1")
  @@index([clock], map: "auditlog_2")
  @@index([resourcetype, resourceid], map: "auditlog_3")
  @@index([recordsetid], map: "auditlog_4")
  @@index([ip], map: "auditlog_5")
}

model autoreg_host {
  autoreg_hostid BigInt  @id
  proxyid        BigInt?
  host           String  @default("") @db.VarChar(128)
  listen_ip      String  @default("") @db.VarChar(39)
  listen_port    Int     @default(0)
  listen_dns     String  @default("") @db.VarChar(255)
  host_metadata  String  @default("")
  flags          Int     @default(0)
  tls_accepted   Int     @default(1)
  proxy          proxy?  @relation(fields: [proxyid], references: [proxyid], onDelete: Cascade, onUpdate: NoAction, map: "c_autoreg_host_1")

  @@index([host], map: "autoreg_host_1")
  @@index([proxyid], map: "autoreg_host_2")
}

model changelog {
  changelogid BigInt @id @default(autoincrement())
  object      Int    @default(0)
  objectid    BigInt
  operation   Int    @default(0)
  clock       Int    @default(0)

  @@index([clock], map: "changelog_1")
}

model conditions {
  conditionid   BigInt  @id
  actionid      BigInt
  conditiontype Int     @default(0)
  operator      Int     @default(0)
  value         String  @default("") @db.VarChar(255)
  value2        String  @default("") @db.VarChar(255)
  actions       actions @relation(fields: [actionid], references: [actionid], onDelete: Cascade, onUpdate: NoAction, map: "c_conditions_1")

  @@index([actionid], map: "conditions_1")
}

model config_autoreg_tls {
  autoreg_tlsid    BigInt @id
  tls_psk_identity String @unique(map: "config_autoreg_tls_1") @default("") @db.VarChar(128)
  tls_psk          String @default("") @db.VarChar(512)
}

model connector {
  connectorid      BigInt          @id
  name             String          @unique(map: "connector_1") @default("") @db.VarChar(255)
  protocol         Int             @default(0)
  data_type        Int             @default(0)
  url              String          @default("") @db.VarChar(2048)
  max_records      Int             @default(0)
  max_senders      Int             @default(1)
  max_attempts     Int             @default(1)
  timeout          String          @default("5s") @db.VarChar(255)
  http_proxy       String          @default("") @db.VarChar(255)
  authtype         Int             @default(0)
  username         String          @default("") @db.VarChar(255)
  password         String          @default("") @db.VarChar(255)
  token            String          @default("") @db.VarChar(128)
  verify_peer      Int             @default(1)
  verify_host      Int             @default(1)
  ssl_cert_file    String          @default("") @db.VarChar(255)
  ssl_key_file     String          @default("") @db.VarChar(255)
  ssl_key_password String          @default("") @db.VarChar(64)
  description      String          @default("")
  status           Int             @default(1)
  tags_evaltype    Int             @default(0)
  item_value_type  Int             @default(31)
  attempt_interval String          @default("5s") @db.VarChar(32)
  connector_tag    connector_tag[]
}

model connector_tag {
  connector_tagid BigInt    @id
  connectorid     BigInt
  tag             String    @default("") @db.VarChar(255)
  operator        Int       @default(0)
  value           String    @default("") @db.VarChar(255)
  connector       connector @relation(fields: [connectorid], references: [connectorid], onDelete: NoAction, onUpdate: NoAction, map: "c_connector_tag_1")

  @@index([connectorid], map: "connector_tag_1")
}

model corr_condition {
  corr_conditionid        BigInt                   @id
  correlationid           BigInt
  type                    Int                      @default(0)
  correlation             correlation              @relation(fields: [correlationid], references: [correlationid], onDelete: Cascade, onUpdate: NoAction, map: "c_corr_condition_1")
  corr_condition_group    corr_condition_group?
  corr_condition_tag      corr_condition_tag?
  corr_condition_tagpair  corr_condition_tagpair?
  corr_condition_tagvalue corr_condition_tagvalue?

  @@index([correlationid], map: "corr_condition_1")
}

model corr_condition_group {
  corr_conditionid BigInt         @id
  operator         Int            @default(0)
  groupid          BigInt
  corr_condition   corr_condition @relation(fields: [corr_conditionid], references: [corr_conditionid], onDelete: Cascade, onUpdate: NoAction, map: "c_corr_condition_group_1")
  hstgrp           hstgrp         @relation(fields: [groupid], references: [groupid], onDelete: NoAction, onUpdate: NoAction, map: "c_corr_condition_group_2")

  @@index([groupid], map: "corr_condition_group_1")
}

model corr_condition_tag {
  corr_conditionid BigInt         @id
  tag              String         @default("") @db.VarChar(255)
  corr_condition   corr_condition @relation(fields: [corr_conditionid], references: [corr_conditionid], onDelete: Cascade, onUpdate: NoAction, map: "c_corr_condition_tag_1")
}

model corr_condition_tagpair {
  corr_conditionid BigInt         @id
  oldtag           String         @default("") @db.VarChar(255)
  newtag           String         @default("") @db.VarChar(255)
  corr_condition   corr_condition @relation(fields: [corr_conditionid], references: [corr_conditionid], onDelete: Cascade, onUpdate: NoAction, map: "c_corr_condition_tagpair_1")
}

model corr_condition_tagvalue {
  corr_conditionid BigInt         @id
  tag              String         @default("") @db.VarChar(255)
  operator         Int            @default(0)
  value            String         @default("") @db.VarChar(255)
  corr_condition   corr_condition @relation(fields: [corr_conditionid], references: [corr_conditionid], onDelete: Cascade, onUpdate: NoAction, map: "c_corr_condition_tagvalue_1")
}

model corr_operation {
  corr_operationid BigInt      @id
  correlationid    BigInt
  type             Int         @default(0)
  correlation      correlation @relation(fields: [correlationid], references: [correlationid], onDelete: Cascade, onUpdate: NoAction, map: "c_corr_operation_1")

  @@index([correlationid], map: "corr_operation_1")
}

model correlation {
  correlationid  BigInt           @id
  name           String           @unique(map: "correlation_2") @default("") @db.VarChar(255)
  description    String           @default("")
  evaltype       Int              @default(0)
  status         Int              @default(0)
  formula        String           @default("") @db.VarChar(255)
  corr_condition corr_condition[]
  corr_operation corr_operation[]

  @@index([status], map: "correlation_1")
}

model dashboard {
  dashboardid      BigInt             @id
  name             String             @db.VarChar(255)
  userid           BigInt?
  private          Int                @default(1)
  templateid       BigInt?
  display_period   Int                @default(30)
  auto_start       Int                @default(1)
  uuid             String             @default("") @db.VarChar(32)
  users            users?             @relation(fields: [userid], references: [userid], onDelete: NoAction, onUpdate: NoAction, map: "c_dashboard_1")
  hosts            hosts?             @relation(fields: [templateid], references: [hostid], onDelete: Cascade, onUpdate: NoAction, map: "c_dashboard_2")
  dashboard_page   dashboard_page[]
  dashboard_user   dashboard_user[]
  dashboard_usrgrp dashboard_usrgrp[]
  report           report[]

  @@index([userid], map: "dashboard_1")
  @@index([templateid], map: "dashboard_2")
  @@index([uuid], map: "dashboard_3")
}

model dashboard_page {
  dashboard_pageid BigInt    @id
  dashboardid      BigInt
  name             String    @default("") @db.VarChar(255)
  display_period   Int       @default(0)
  sortorder        Int       @default(0)
  dashboard        dashboard @relation(fields: [dashboardid], references: [dashboardid], onDelete: Cascade, onUpdate: NoAction, map: "c_dashboard_page_1")
  widget           widget[]

  @@index([dashboardid], map: "dashboard_page_1")
}

model dashboard_user {
  dashboard_userid BigInt    @id
  dashboardid      BigInt
  userid           BigInt
  permission       Int       @default(2)
  dashboard        dashboard @relation(fields: [dashboardid], references: [dashboardid], onDelete: Cascade, onUpdate: NoAction, map: "c_dashboard_user_1")
  users            users     @relation(fields: [userid], references: [userid], onDelete: Cascade, onUpdate: NoAction, map: "c_dashboard_user_2")

  @@unique([dashboardid, userid], map: "dashboard_user_1")
  @@index([userid], map: "dashboard_user_2")
}

model dashboard_usrgrp {
  dashboard_usrgrpid BigInt    @id
  dashboardid        BigInt
  usrgrpid           BigInt
  permission         Int       @default(2)
  dashboard          dashboard @relation(fields: [dashboardid], references: [dashboardid], onDelete: Cascade, onUpdate: NoAction, map: "c_dashboard_usrgrp_1")
  usrgrp             usrgrp    @relation(fields: [usrgrpid], references: [usrgrpid], onDelete: Cascade, onUpdate: NoAction, map: "c_dashboard_usrgrp_2")

  @@unique([dashboardid, usrgrpid], map: "dashboard_usrgrp_1")
  @@index([usrgrpid], map: "dashboard_usrgrp_2")
}

model dbversion {
  dbversionid BigInt @id
  mandatory   Int    @default(0)
  optional    Int    @default(0)
}

model dchecks {
  dcheckid              BigInt      @id
  druleid               BigInt
  type                  Int         @default(0)
  key_                  String      @default("") @db.VarChar(2048)
  snmp_community        String      @default("") @db.VarChar(255)
  ports                 String      @default("0") @db.VarChar(255)
  snmpv3_securityname   String      @default("") @db.VarChar(64)
  snmpv3_securitylevel  Int         @default(0)
  snmpv3_authpassphrase String      @default("") @db.VarChar(64)
  snmpv3_privpassphrase String      @default("") @db.VarChar(64)
  uniq                  Int         @default(0)
  snmpv3_authprotocol   Int         @default(0)
  snmpv3_privprotocol   Int         @default(0)
  snmpv3_contextname    String      @default("") @db.VarChar(255)
  host_source           Int         @default(1)
  name_source           Int         @default(0)
  allow_redirect        Int         @default(0)
  drules                drules      @relation(fields: [druleid], references: [druleid], onDelete: NoAction, onUpdate: NoAction, map: "c_dchecks_1")
  dservices             dservices[]

  @@index([druleid, host_source, name_source], map: "dchecks_1")
}

model dhosts {
  dhostid   BigInt      @id
  druleid   BigInt
  status    Int         @default(0)
  lastup    Int         @default(0)
  lastdown  Int         @default(0)
  drules    drules      @relation(fields: [druleid], references: [druleid], onDelete: Cascade, onUpdate: NoAction, map: "c_dhosts_1")
  dservices dservices[]

  @@index([druleid], map: "dhosts_1")
}

model drules {
  druleid         BigInt    @id
  proxyid         BigInt?
  name            String    @unique(map: "drules_2") @default("") @db.VarChar(255)
  iprange         String    @default("") @db.VarChar(2048)
  delay           String    @default("1h") @db.VarChar(255)
  status          Int       @default(0)
  concurrency_max Int       @default(0)
  error           String    @default("") @db.VarChar(2048)
  dchecks         dchecks[]
  dhosts          dhosts[]
  proxy           proxy?    @relation(fields: [proxyid], references: [proxyid], onDelete: NoAction, onUpdate: NoAction, map: "c_drules_1")

  @@index([proxyid], map: "drules_1")
}

model dservices {
  dserviceid BigInt  @id
  dhostid    BigInt
  value      String  @default("") @db.VarChar(255)
  port       Int     @default(0)
  status     Int     @default(0)
  lastup     Int     @default(0)
  lastdown   Int     @default(0)
  dcheckid   BigInt
  ip         String  @default("") @db.VarChar(39)
  dns        String  @default("") @db.VarChar(255)
  dhosts     dhosts  @relation(fields: [dhostid], references: [dhostid], onDelete: Cascade, onUpdate: NoAction, map: "c_dservices_1")
  dchecks    dchecks @relation(fields: [dcheckid], references: [dcheckid], onDelete: Cascade, onUpdate: NoAction, map: "c_dservices_2")

  @@unique([dcheckid, ip, port], map: "dservices_1")
  @@index([dhostid], map: "dservices_2")
}

model escalations {
  escalationid   BigInt  @id
  actionid       BigInt
  triggerid      BigInt?
  eventid        BigInt?
  r_eventid      BigInt?
  nextcheck      Int     @default(0)
  esc_step       Int     @default(0)
  status         Int     @default(0)
  itemid         BigInt?
  acknowledgeid  BigInt?
  servicealarmid BigInt?
  serviceid      BigInt?

  @@unique([triggerid, itemid, serviceid, escalationid], map: "escalations_1")
  @@index([eventid], map: "escalations_2")
  @@index([nextcheck], map: "escalations_3")
}

model event_recovery {
  eventid                                 BigInt  @id
  r_eventid                               BigInt
  c_eventid                               BigInt?
  correlationid                           BigInt?
  userid                                  BigInt?
  events_event_recovery_eventidToevents   events  @relation("event_recovery_eventidToevents", fields: [eventid], references: [eventid], onDelete: Cascade, onUpdate: NoAction, map: "c_event_recovery_1")
  events_event_recovery_r_eventidToevents events  @relation("event_recovery_r_eventidToevents", fields: [r_eventid], references: [eventid], onDelete: Cascade, onUpdate: NoAction, map: "c_event_recovery_2")
  events_event_recovery_c_eventidToevents events? @relation("event_recovery_c_eventidToevents", fields: [c_eventid], references: [eventid], onDelete: Cascade, onUpdate: NoAction, map: "c_event_recovery_3")

  @@index([r_eventid], map: "event_recovery_1")
  @@index([c_eventid], map: "event_recovery_2")
}

model event_suppress {
  event_suppressid BigInt        @id
  eventid          BigInt
  maintenanceid    BigInt?
  suppress_until   Int           @default(0)
  userid           BigInt?
  events           events        @relation(fields: [eventid], references: [eventid], onDelete: Cascade, onUpdate: NoAction, map: "c_event_suppress_1")
  maintenances     maintenances? @relation(fields: [maintenanceid], references: [maintenanceid], onDelete: Cascade, onUpdate: NoAction, map: "c_event_suppress_2")
  users            users?        @relation(fields: [userid], references: [userid], onDelete: Cascade, onUpdate: NoAction, map: "c_event_suppress_3")

  @@unique([eventid, maintenanceid], map: "event_suppress_1")
  @@index([suppress_until], map: "event_suppress_2")
  @@index([maintenanceid], map: "event_suppress_3")
  @@index([userid], map: "event_suppress_4")
}

model event_symptom {
  eventid                                    BigInt @id
  cause_eventid                              BigInt
  events_event_symptom_eventidToevents       events @relation("event_symptom_eventidToevents", fields: [eventid], references: [eventid], onDelete: Cascade, onUpdate: NoAction, map: "c_event_symptom_1")
  events_event_symptom_cause_eventidToevents events @relation("event_symptom_cause_eventidToevents", fields: [cause_eventid], references: [eventid], onDelete: NoAction, onUpdate: NoAction, map: "c_event_symptom_2")

  @@index([cause_eventid], map: "event_symptom_1")
}

model event_tag {
  eventtagid BigInt @id
  eventid    BigInt
  tag        String @default("") @db.VarChar(255)
  value      String @default("") @db.VarChar(255)
  events     events @relation(fields: [eventid], references: [eventid], onDelete: Cascade, onUpdate: NoAction, map: "c_event_tag_1")

  @@index([eventid], map: "event_tag_1")
}

model events {
  eventid                                           BigInt           @id
  source                                            Int              @default(0)
  object                                            Int              @default(0)
  objectid                                          BigInt           @default(0)
  clock                                             Int              @default(0)
  value                                             Int              @default(0)
  acknowledged                                      Int              @default(0)
  ns                                                Int              @default(0)
  name                                              String           @default("") @db.VarChar(2048)
  severity                                          Int              @default(0)
  acknowledges                                      acknowledges[]
  alerts_alerts_eventidToevents                     alerts[]         @relation("alerts_eventidToevents")
  alerts_alerts_p_eventidToevents                   alerts[]         @relation("alerts_p_eventidToevents")
  event_recovery_event_recovery_eventidToevents     event_recovery?  @relation("event_recovery_eventidToevents")
  event_recovery_event_recovery_r_eventidToevents   event_recovery[] @relation("event_recovery_r_eventidToevents")
  event_recovery_event_recovery_c_eventidToevents   event_recovery[] @relation("event_recovery_c_eventidToevents")
  event_suppress                                    event_suppress[]
  event_symptom_event_symptom_eventidToevents       event_symptom?   @relation("event_symptom_eventidToevents")
  event_symptom_event_symptom_cause_eventidToevents event_symptom[]  @relation("event_symptom_cause_eventidToevents")
  event_tag                                         event_tag[]
  problem_problem_eventidToevents                   problem?         @relation("problem_eventidToevents")
  problem_problem_r_eventidToevents                 problem[]        @relation("problem_r_eventidToevents")
  problem_problem_cause_eventidToevents             problem[]        @relation("problem_cause_eventidToevents")

  @@index([source, object, objectid, clock], map: "events_1")
  @@index([source, object, clock], map: "events_2")
}

model expressions {
  expressionid    BigInt  @id
  regexpid        BigInt
  expression      String  @default("") @db.VarChar(255)
  expression_type Int     @default(0)
  exp_delimiter   String  @default("") @db.VarChar(1)
  case_sensitive  Int     @default(0)
  regexps         regexps @relation(fields: [regexpid], references: [regexpid], onDelete: Cascade, onUpdate: NoAction, map: "c_expressions_1")

  @@index([regexpid], map: "expressions_1")
}

model functions {
  functionid BigInt   @id
  itemid     BigInt
  triggerid  BigInt
  name       String   @default("") @db.VarChar(12)
  parameter  String   @default("0") @db.VarChar(255)
  items      items    @relation(fields: [itemid], references: [itemid], onDelete: NoAction, onUpdate: NoAction, map: "c_functions_1")
  triggers   triggers @relation(fields: [triggerid], references: [triggerid], onDelete: NoAction, onUpdate: NoAction, map: "c_functions_2")

  @@index([triggerid], map: "functions_1")
  @@index([itemid, name, parameter], map: "functions_2")
}

model globalmacro {
  globalmacroid BigInt @id
  macro         String @unique(map: "globalmacro_1") @default("") @db.VarChar(255)
  value         String @default("") @db.VarChar(2048)
  description   String @default("")
  type          Int    @default(0)
}

model globalvars {
  name  String @id @default("") @db.VarChar(64)
  value String @default("") @db.VarChar(2048)
}

model graph_discovery {
  graphid                                       BigInt @id
  parent_graphid                                BigInt
  lastcheck                                     Int    @default(0)
  ts_delete                                     Int    @default(0)
  status                                        Int    @default(0)
  graphs_graph_discovery_graphidTographs        graphs @relation("graph_discovery_graphidTographs", fields: [graphid], references: [graphid], onDelete: Cascade, onUpdate: NoAction, map: "c_graph_discovery_1")
  graphs_graph_discovery_parent_graphidTographs graphs @relation("graph_discovery_parent_graphidTographs", fields: [parent_graphid], references: [graphid], onDelete: NoAction, onUpdate: NoAction, map: "c_graph_discovery_2")

  @@index([parent_graphid], map: "graph_discovery_1")
}

model graph_theme {
  graphthemeid         BigInt @id
  theme                String @unique(map: "graph_theme_1") @default("") @db.VarChar(64)
  backgroundcolor      String @default("") @db.VarChar(6)
  graphcolor           String @default("") @db.VarChar(6)
  gridcolor            String @default("") @db.VarChar(6)
  maingridcolor        String @default("") @db.VarChar(6)
  gridbordercolor      String @default("") @db.VarChar(6)
  textcolor            String @default("") @db.VarChar(6)
