PORT=3000
NODE_ENV=development

AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=
AZURE_REDIRECT_URI=http://localhost:3000/auth/callback

FRONTEND_URL=http://localhost:5173

SESSION_SECRET=
SESSION_COOKIE_SAME_SITE=lax
# Configure somente se o cookie precisar ser compartilhado entre subdomínios.
SESSION_COOKIE_DOMAIN=

# Gateway Guacamole Lite (iniciado separadamente com npm run start:guacamole)
GUAC_PORT=8190
GUACD_HOST=127.0.0.1
GUACD_PORT=4822
API_BEARER_TOKEN=replace-with-at-least-32-random-bytes
GUAC_KEY=replace-with-exactly-32-random-bytes
GUAC_DRIVE_PATH=/var/lib/guacamole/drives
GUAC_WS_PUBLIC_URL=ws://localhost:8190
GUAC_MAX_UPLOAD_BYTES=52428800
CORS_ORIGINS=http://localhost:5173
GUACAMOLE_BASE_URL=http://10.86.26.18:8410/
GUACAMOLE_TIMEOUT_MS=10000

# Mantenha tambm as variveis j usadas pela API (bancos, SECRET_KEY e GUAC_*)
# ao atualizar um .env existente; este exemplo documenta as variveis do fluxo Microsoft.
