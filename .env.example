PORT=3000
NODE_ENV=development

AZURE_CLIENT_ID=seu-client-id
AZURE_CLIENT_SECRET=seu-client-secret
AZURE_TENANT_ID=seu-tenant-id
AZURE_REDIRECT_URI=http://localhost:5173/auth/callback

FRONTEND_URL=http://localhost:5173

SESSION_SECRET=seu-session-secret

# Mantenha também as variáveis já usadas pela API (bancos, SECRET_KEY e GUAC_*)
# ao atualizar um .env existente; este exemplo documenta as variáveis do fluxo Microsoft.
